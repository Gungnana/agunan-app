APP_ENV=production
APP_NAME=Sistem Analisa Agunan Berbasis Data Pasar
APP_VERSION=1.0.0
DEBUG=False

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Security & Authentication
# WAJIB DIISI: Ganti dengan string acak minimal 32 karakter
SECRET_KEY=GANTI_DENGAN_SECRET_KEY_AMAN_MINIMAL_32_KARAKTER_UNIK
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS - Isi dengan URL frontend Vercel Anda
CORS_ORIGINS=https://NAMA-APP-ANDA.vercel.app,https://www.domain-anda.com

# Database - Supabase PostgreSQL (Gratis)
# Format Transaction Pooler (direkomendasikan untuk Vercel Serverless, port 6543):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Atau Direct Connection (port 5432):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Search Engine API Configuration
# Pilihan 1: Google Custom Search JSON API (Gratis 100 req/hari = ~3.000 req/bulan)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Pilihan 2: Brave Search API (Gratis 2.000 req/bulan)
BRAVE_SEARCH_API_KEY=BSAdpcrAFpA-ae5TqkyP5rJIMcgxwni

# Akun Awal (Auto-seeded saat pertama kali start)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@bank.co.id
INITIAL_ADMIN_PASSWORD=GANTI_ADMIN_PASSWORD_AMAN
INITIAL_ADMIN_FULLNAME=Administrator Valuasi

INITIAL_ANALIS_USERNAME=analis1
INITIAL_ANALIS_EMAIL=analis1@bank.co.id
INITIAL_ANALIS_PASSWORD=GANTI_ANALIS_PASSWORD_AMAN
INITIAL_ANALIS_FULLNAME=Budi Pratama (Analis Kredit)

INITIAL_REVIEWER_USERNAME=reviewer1
INITIAL_REVIEWER_EMAIL=reviewer1@bank.co.id
INITIAL_REVIEWER_PASSWORD=GANTI_REVIEWER_PASSWORD_AMAN
INITIAL_REVIEWER_FULLNAME=Siti Rahayu (Reviewer Agunan)
