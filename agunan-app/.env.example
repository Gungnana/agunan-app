# ==============================================================================
# SISTEM ANALISA AGUNAN BERBASIS DATA PASAR - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development / staging / production)
APP_ENV=development
APP_NAME="Sistem Analisa Agunan Berbasis Data Pasar"
APP_VERSION=1.0.0
DEBUG=True

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Security & Authentication
# Generate a unique value before deployment. Never commit your real .env.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Origins (pisahkan dengan koma jika lebih dari satu)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost

# Database Configuration (MySQL 8.0)
MYSQL_HOST=mysql-db
MYSQL_PORT=3306
MYSQL_DATABASE=db_analisa_agunan
MYSQL_USER=agunan_user
MYSQL_PASSWORD=change-this-local-database-password
MYSQL_ROOT_PASSWORD=change-this-local-root-password

# SQLAlchemy Database URL (Driver: pymysql)
DATABASE_URL=mysql+pymysql://agunan_user:change-this-local-database-password@mysql-db:3306/db_analisa_agunan

# Inisialisasi Akun Awal (Auto-seeded pada start pertama jika belum ada)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@bank.co.id
INITIAL_ADMIN_PASSWORD=change-this-admin-password
INITIAL_ADMIN_FULLNAME="Administrator Valuasi"

INITIAL_ANALIS_USERNAME=analis1
INITIAL_ANALIS_EMAIL=analis1@bank.co.id
INITIAL_ANALIS_PASSWORD=change-this-analyst-password
INITIAL_ANALIS_FULLNAME="Budi Pratama (Analis Kredit)"

INITIAL_REVIEWER_USERNAME=reviewer1
INITIAL_REVIEWER_EMAIL=reviewer1@bank.co.id
INITIAL_REVIEWER_PASSWORD=change-this-reviewer-password
INITIAL_REVIEWER_FULLNAME="Siti Rahayu (Reviewer Agunan)"

# Brave Search API key, optional until web search is enabled.
BRAVE_SEARCH_API_KEY=
